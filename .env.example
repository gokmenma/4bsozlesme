# Database Settings
DB_HOST=localhost
DB_NAME=sozlesme
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Kadro Bildirim Sistemi"

# Google Gemini API (personel belge tarama / AI OCR)
# Boş bırakılırsa AiService mock veri döndürür (geliştirme modu).
GEMINI_API_KEY=

# Security & Encryption Key (AES-256-GCM 32 bytes hex)
APP_KEY=

# Personel evrak bağlantılarında kullanılacak tam adres (ör. https://4bsozlesme.com). Boşsa istek adresinden üretilir.
APP_URL=

# Personel evrak dosyalarının (şifreli) saklanacağı web dışı dizin. Boşsa storage/private/evrak kullanılır.
EVRAK_STORAGE_PATH=
